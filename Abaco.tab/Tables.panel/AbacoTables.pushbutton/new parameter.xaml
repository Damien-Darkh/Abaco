<!--
    NEW CUSTOM FIELD window (Abaco Tables, Phase 7 editor). Version 1 grammar.
    Brush keys match ui.xaml, so ui_theme.py can swap them for dark mode.

    CODE CONTRACT
    - Keys: Tag holds the text to insert. "@" marks where the caret goes afterwards and is removed.
      key_click calls insert_key(formula, tag). Keys are Focusable="False", so focus stays in the formula box.
    - insert_field_click and fields_list_double_click insert "{Label}" at the caret (insert_field).
    - formula_changed runs formula.check(). Syntax and checker errors fill status_box (ErrBg) and show
      preview_box with the first problem. A valid formula shows GoodBg. Element errors from a dry run show
      WarnBg and preview_box with the first failing row.
    - result_unit_text is set from the checked formula's type (unit_text). Never edited by hand.
    - example_text is set by code from the table's fields, using the same units as the checker needs.
    - name_changed checks uniqueness; fields_search_changed filters fields_list (table fields only).
    - save_click reruns the checks and closes with DialogResult true. cancel_click closes without saving.
-->
<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="New custom field" Width="900" Height="700" MinWidth="820" MinHeight="660"
        WindowStartupLocation="CenterScreen" Background="#F4F5F7"
        FontFamily="Segoe UI" FontSize="12" UseLayoutRounding="True" SnapsToDevicePixels="True"
        ShowInTaskbar="False">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="B2V"/>

        <!-- ================= brushes (same keys as ui.xaml) ================= -->
        <SolidColorBrush x:Key="Accent" Color="#2F6FDE"/>
        <SolidColorBrush x:Key="AccentHover" Color="#2459B8"/>
        <SolidColorBrush x:Key="AccentSoft" Color="#EAF1FD"/>
        <SolidColorBrush x:Key="Line" Color="#D5D9E0"/>
        <SolidColorBrush x:Key="LineSoft" Color="#E6E8EC"/>
        <SolidColorBrush x:Key="Muted" Color="#5B6472"/>
        <SolidColorBrush x:Key="Ink" Color="#1C1F24"/>
        <SolidColorBrush x:Key="WarnBg" Color="#FDEBD9"/>
        <SolidColorBrush x:Key="WarnText" Color="#8A4B08"/>
        <SolidColorBrush x:Key="GoodBg" Color="#E3F3EA"/>
        <SolidColorBrush x:Key="GoodText" Color="#14653D"/>
        <SolidColorBrush x:Key="ErrBg" Color="#FBE3E3"/>
        <SolidColorBrush x:Key="ErrText" Color="#9B1C1C"/>

        <!-- ================= surfaces and text ================= -->
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="{StaticResource Line}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Padding" Value="14,12"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
        </Style>
        <Style x:Key="CardTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
        </Style>
        <Style x:Key="Label" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource Muted}"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Margin" Value="0,0,0,4"/>
        </Style>
        <Style x:Key="Hint" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource Muted}"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Margin" Value="0,4,0,0"/>
        </Style>
        <Style x:Key="SectionLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource Muted}"/>
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,10,0,5"/>
        </Style>

        <!-- chips -->
        <Style x:Key="ChipInfo" TargetType="Border">
            <Setter Property="Background" Value="#E6EEFB"/>
            <Setter Property="CornerRadius" Value="3"/>
            <Setter Property="Padding" Value="6,2"/>
            <Setter Property="HorizontalAlignment" Value="Left"/>
        </Style>
        <Style x:Key="ChipText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Foreground" Value="#3B4350"/>
        </Style>

        <!-- ================= inputs ================= -->
        <Style x:Key="FieldBox" TargetType="TextBox">
            <Setter Property="Height" Value="28"/>
            <Setter Property="Padding" Value="6,0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="BorderBrush" Value="{StaticResource Line}"/>
        </Style>
        <Style x:Key="FormulaBox" TargetType="TextBox">
            <Setter Property="MinHeight" Value="38"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="FontFamily" Value="Consolas"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="AcceptsReturn" Value="False"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="BorderBrush" Value="{StaticResource Line}"/>
        </Style>

        <!-- ================= keyboard keys ================= -->
        <Style x:Key="KeyBtn" TargetType="Button">
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Foreground" Value="{StaticResource Ink}"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="MinWidth" Value="40"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="Margin" Value="0,0,6,6"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="ToolTipService.InitialShowDelay" Value="400"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}"
                                BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="4"
                                Padding="10,0">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{StaticResource AccentSoft}"/>
                                <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource Accent}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{StaticResource Accent}"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- keywords, logic and units: accent text -->
        <Style x:Key="KeyKw" TargetType="Button" BasedOn="{StaticResource KeyBtn}">
            <Setter Property="Foreground" Value="{StaticResource Accent}"/>
        </Style>

        <!-- ================= buttons ================= -->
        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="{StaticResource Accent}"/>
            <Setter Property="Padding" Value="20,7"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="4"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{StaticResource AccentHover}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="bd" Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="SecondaryButton" TargetType="Button">
            <Setter Property="Foreground" Value="{StaticResource Ink}"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="Padding" Value="14,6"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="4"
                                BorderBrush="{StaticResource Line}" BorderThickness="1"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#EEF2FA"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="bd" Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- field list row -->
        <Style x:Key="FieldItem" TargetType="ListBoxItem">
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="bd" Background="Transparent" BorderBrush="Transparent"
                                BorderThickness="1" CornerRadius="3" Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#F4F7FC"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{StaticResource AccentSoft}"/>
                                <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource Accent}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ================= header ================= -->
        <StackPanel Grid.Row="0" Margin="0,0,0,12">
            <TextBlock Text="New custom field" FontSize="20" FontWeight="SemiBold"/>
            <TextBlock Style="{StaticResource Hint}" Margin="0,2,0,0"
                       Text="Calculate a value for each row from its fields. Type the formula, or click the keys. They go in where the cursor is."/>
        </StackPanel>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MinWidth="460"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="320"/>
            </Grid.ColumnDefinitions>

            <!-- ============================ LEFT: the field and its formula ============================ -->
            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- field settings -->
                <Border Grid.Row="0" Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource CardTitle}" Text="Field"/>

                        <TextBlock Style="{StaticResource Label}" Text="Name"/>
                        <TextBox x:Name="name_box" Style="{StaticResource FieldBox}"
                                 ToolTip="Shown as the column heading"
                                 TextChanged="name_changed"/>
                        <TextBlock x:Name="name_status" Style="{StaticResource Hint}"
                                   Text="Shown as the column heading. It must be unique in this table."/>

                        <TextBlock Style="{StaticResource Label}" Text="Kind" Margin="0,10,0,6"/>
                        <StackPanel Orientation="Horizontal">
                            <RadioButton x:Name="kind_calc" GroupName="kind" Style="{StaticResource Seg}"
                                        Content="Calculated" IsChecked="True" Click="kind_changed" Margin="0,0,8,0"
                                        ToolTip="Worked out from the table's fields for each row. Not stored in the model."/>
                            <RadioButton x:Name="kind_notes" GroupName="kind" Style="{StaticResource Seg}"
                                        Content="Notes / comments" IsEnabled="False" Click="kind_changed"
                                        ToolTip="Text typed for each element and stored in the model. Available from Phase 8."/>
                        </StackPanel>
                        <TextBlock Style="{StaticResource Hint}"
                                Text="Notes / comments: available from Phase 8, when fields are created in the model."/>
                        <!-- Phase 8: add "Calculated" / "Model parameter" radio buttons here and a categories list -->
                    </StackPanel>
                </Border>

                <!-- formula -->
                <Border Grid.Row="1" Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource CardTitle}" Text="Formula"/>
                        <TextBox x:Name="formula" Style="{StaticResource FormulaBox}"
                                 ToolTip="Type here, or click the keys below"
                                 TextChanged="formula_changed"/>

                        <Border x:Name="status_box" Background="{StaticResource GoodBg}" CornerRadius="4"
                                Padding="10,6" Margin="0,8,0,0">
                            <TextBlock x:Name="status_text" TextWrapping="Wrap"
                                       Foreground="{StaticResource GoodText}"
                                       Text="Start typing, or click a key."/>
                        </Border>

                        <!-- shown only when the formula or a row has an error -->
                        <Border x:Name="preview_box" Background="{StaticResource ErrBg}" CornerRadius="4"
                                Padding="10,6" Margin="0,6,0,0" Visibility="Collapsed">
                            <StackPanel>
                                <TextBlock Text="Where it fails" FontSize="10" FontWeight="SemiBold"
                                           Foreground="{StaticResource ErrText}"/>
                                <TextBlock x:Name="preview_text" TextWrapping="Wrap" FontFamily="Consolas" FontSize="12"
                                           Foreground="{StaticResource ErrText}"/>
                            </StackPanel>
                        </Border>

                        <TextBlock Style="{StaticResource Hint}"
                                   Text="Write one expression. Use IF(condition, a, b) to choose between two values. Every value is a number, a text, or TRUE or FALSE."/>
                    </StackPanel>
                </Border>

                <!-- keys -->
                <Border Grid.Row="2" Style="{StaticResource Card}" Margin="0" x:Name="keys_card">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <TextBlock Style="{StaticResource CardTitle}" Text="Keys"/>

                        <Grid Grid.Row="1">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- LEFT column: operators and comparisons, anchored to the left edge -->
                            <Grid Grid.Column="0" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>

                                <!-- left row 1: arithmetic -->
                                <Grid Grid.Row="0" Margin="0,0,0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" Height="*"/><ColumnDefinition Width="*" Height="*"/><ColumnDefinition Width="*" Height="*"/>
                                        <ColumnDefinition Width="*" Height="*"/><ColumnDefinition Width="*" Height="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Button Grid.Column="0" Style="{StaticResource KeyBtn}" Content="+" Tag=" + " Click="key_click" ToolTip="Add numbers, or join two texts. {Width (m)} + 1 m"/>
                                    <Button Grid.Column="1" Style="{StaticResource KeyBtn}" Content="−" Tag=" - " Click="key_click" ToolTip="Subtract. {Area (m²)} - 2 m²"/>
                                    <Button Grid.Column="2" Style="{StaticResource KeyBtn}" Content="×" Tag=" * " Click="key_click" ToolTip="Multiply. {Width (m)} * {Height (m)}"/>
                                    <Button Grid.Column="3" Style="{StaticResource KeyBtn}" Content="÷" Tag=" / " Click="key_click" ToolTip="Divide. {Area (m²)} / {Width (m)}. A zero divisor gives #ERROR"/>
                                    <Button Grid.Column="4" Style="{StaticResource KeyBtn}" Content="%" Tag=" % " Click="key_click" ToolTip="Remainder after division. 7 % 3 = 1"/>
                                </Grid>

                                <!-- left row 2: brackets, separator, equals -->
                                <Grid Grid.Row="1" Margin="0,0,0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" Height="*"/><ColumnDefinition Width="*" Height="*"/><ColumnDefinition Width="*" Height="*"/><ColumnDefinition Width="*" Height="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Button Grid.Column="0" Style="{StaticResource KeyBtn}" Content="(" Tag="(" Click="key_click" ToolTip="Groups part of a formula. ({Width (m)} + 1 m) * 2"/>
                                    <Button Grid.Column="1" Style="{StaticResource KeyBtn}" Content=")" Tag=")" Click="key_click" ToolTip="Closes a group"/>
                                    <Button Grid.Column="2" Style="{StaticResource KeyBtn}" Content="," Tag=", " Click="key_click" ToolTip="Separates the parts of a function. ROOT({Volume (m³)}, 3)"/>
                                    <Button Grid.Column="3" Style="{StaticResource KeyBtn}" Content="=" Tag=" = " Click="key_click" ToolTip="Equal to. {Height (m)} = 3 m"/>
                                    <Button Grid.Column="4" Style="{StaticResource KeyBtn}" Content="^" Tag=" ^ " Click="key_click" ToolTip="Power with a whole-number exponent. {Width (m)} ^ 2"/>
            
                                </Grid>

                                <!-- left row 3: comparisons -->
                                <Grid Grid.Row="2" Margin="0,0,0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" Height="*"/><ColumnDefinition Width="*" Height="*"/><ColumnDefinition Width="*" Height="*"/>
                                        <ColumnDefinition Width="*" Height="*"/><ColumnDefinition Width="*" Height="*"/>
                                    </Grid.ColumnDefinitions>
                                        <Button Grid.Column="0" Style="{StaticResource KeyBtn}" Content="!=" Tag=" != " Click="key_click" ToolTip="Not equal to. {Height (m)} != 3 m"/>
                                        <Button Grid.Column="1" Style="{StaticResource KeyBtn}" Content="&lt;" Tag=" &lt; " Click="key_click" ToolTip="Less than. {Height (m)} &lt; 3 m"/>
                                        <Button Grid.Column="2" Style="{StaticResource KeyBtn}" Content="&gt;" Tag=" &gt; " Click="key_click" ToolTip="Greater than. {Height (m)} &gt; 3 m"/>
                                        <Button Grid.Column="3" Style="{StaticResource KeyBtn}" Content="&lt;=" Tag=" &lt;= " Click="key_click" ToolTip="Less than or equal to. {Height (m)} &lt;= 3 m"/>
                                        <Button Grid.Column="4" Style="{StaticResource KeyBtn}" Content="&gt;=" Tag=" &gt;= " Click="key_click" ToolTip="Greater than or equal to. {Height (m)} &gt;= 3 m"/>
                                    </Grid>

                                <!-- left row 4: roots -->
                                <Grid Grid.Row="3">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" Height="*"/><ColumnDefinition Width="*" Height="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Button Grid.Column="0" Style="{StaticResource KeyKw}" Content="SQRT" Tag="SQRT(@)" Click="key_click" ToolTip="Square root. SQRT({Area (m²)}) is a length"/>
                                    <Button Grid.Column="1" Style="{StaticResource KeyKw}" Content="ROOT" Tag="ROOT(@, 3)" Click="key_click" ToolTip="Root of the degree you give. ROOT({Volume (m³)}, 3) is a length"/>
                                </Grid>
                            </Grid>

                            <!-- RIGHT column: words and values, anchored to the right edge -->
                            <Grid Grid.Column="2" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>

                                <!-- right row 1: logic and literals -->
                                <Grid Grid.Row="0" Margin="0,0,0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" Height="*"/><ColumnDefinition Width="*" Height="*"/><ColumnDefinition Width="*" Height="*"/><ColumnDefinition Width="*" Height="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Button Grid.Column="0" Style="{StaticResource KeyKw}" Content="AND" Tag=" AND " Click="key_click" ToolTip="Both must be TRUE. {Count} &gt; 2 AND {Height (m)} &gt; 1 m"/>
                                    <Button Grid.Column="1" Style="{StaticResource KeyKw}" Content="OR" Tag=" OR " Click="key_click" ToolTip="At least one must be TRUE. {Count} &gt; 2 OR {Height (m)} &gt; 1 m"/>
                                    <Button Grid.Column="2" Style="{StaticResource KeyKw}" Content="TRUE" Tag="TRUE" Click="key_click" ToolTip="The value TRUE. Typed as true, in any capitals"/>
                                    <Button Grid.Column="3" Style="{StaticResource KeyKw}" Content="FALSE" Tag="FALSE" Click="key_click" ToolTip="The value FALSE. Typed as false, in any capitals"/>
                                </Grid>

                                <!-- right row 2: units -->
                                <Grid Grid.Row="1" Margin="0,0,0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" Height="*"/><ColumnDefinition Width="*" Height="*"/><ColumnDefinition Width="*" Height="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Button Grid.Column="0" Style="{StaticResource KeyKw}" Content="m" Tag="m" Click="key_click" ToolTip="Metres. Put it after a number or a count: 2 m, {Count} m"/>
                                    <Button Grid.Column="1" Style="{StaticResource KeyKw}" Content="m²" Tag="m²" Click="key_click" ToolTip="Square metres. 2 m²"/>
                                    <Button Grid.Column="2" Style="{StaticResource KeyKw}" Content="m³" Tag="m³" Click="key_click" ToolTip="Cubic metres. 2 m³"/>
                                </Grid>

                                <!-- right row 3: conditional and min/max/abs -->
                                <Grid Grid.Row="2" Margin="0,0,0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" Height="*"/><ColumnDefinition Width="*" Height="*"/><ColumnDefinition Width="*" Height="*"/><ColumnDefinition Width="*" Height="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Button Grid.Column="0" Style="{StaticResource KeyKw}" Content="IF" Tag="IF(@, , )" Click="key_click" ToolTip="Choose one of two values. IF(condition, a, b). Both values need the same type and unit"/>
                                    <Button Grid.Column="1" Style="{StaticResource KeyKw}" Content="MIN" Tag="MIN(@, )" Click="key_click" ToolTip="The smaller of two or more values with one unit. MIN({Width (m)}, 1 m)"/>
                                    <Button Grid.Column="2" Style="{StaticResource KeyKw}" Content="MAX" Tag="MAX(@, )" Click="key_click" ToolTip="The larger of two or more values with one unit. MAX({Width (m)}, 1 m)"/>
                                    <Button Grid.Column="3" Style="{StaticResource KeyKw}" Content="ABS" Tag="ABS(@)" Click="key_click" ToolTip="Absolute value, always positive. ABS({Height (m)} - 1 m)"/>
                                </Grid>

                                <!-- right row 4: conversions and text comparison -->
                                <Grid Grid.Row="3">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" Height="*"/>
                                        <ColumnDefinition Width="*" Height="*"/>
                                        <ColumnDefinition Width="*" Height="*"/>
                                        <ColumnDefinition Width="Auto" Height="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Button Grid.Column="0" Style="{StaticResource KeyKw}" Content="INT" Tag="INT(@)" Click="key_click" ToolTip="Whole number, rounded half away from zero. INT({Height (m)})"/>
                                    <Button Grid.Column="1" Style="{StaticResource KeyKw}" Content="FLOAT" Tag="FLOAT(@)" Click="key_click" ToolTip="Decimal number. FLOAT({Count})"/>
                                    <Button Grid.Column="2" Style="{StaticResource KeyKw}" Content="STRING" Tag="STRING(@)" Click="key_click" ToolTip="Text. STRING({Count})"/>
                                    <Button Grid.Column="3" Style="{StaticResource KeyKw}" FontSize="11" Content="SENSITIVE" Tag="SENSITIVE(@)" Click="key_click" ToolTip="Text comparison that respects capitals. Use with = or !="/>
                                </Grid>
                            </Grid>
                        </Grid>
                    </Grid>
                </Border>
            </Grid>

            <!-- ============================ RIGHT: fields and example ============================ -->
            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Style="{StaticResource Card}" Margin="0,0,0,10">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" Width="Auto"/>
                            <RowDefinition Height="Auto" Width="Auto"/>
                            <RowDefinition Height="*" Width="Auto"/>
                            <RowDefinition Height="Auto" Width="Auto"/>
                            <RowDefinition Height="Auto" Width="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Style="{StaticResource CardTitle}" Text="Fields in this table"/>

                        <TextBox Grid.Row="1" x:Name="fields_search" Style="{StaticResource FieldBox}"
                                 ToolTip="Search the fields of this table"
                                 TextChanged="fields_search_changed"/>

                        <ListBox Grid.Row="2" x:Name="fields_list" Margin="0,8,0,0"
                                 BorderBrush="{StaticResource Line}" BorderThickness="1"
                                 ItemContainerStyle="{StaticResource FieldItem}"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 MouseDoubleClick="fields_list_double_click">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding Label}" VerticalAlignment="Center"
                                                   TextTrimming="CharacterEllipsis"/>
                                        <Border Grid.Column="1" Style="{StaticResource ChipInfo}" Margin="6,0,0,0">
                                            <TextBlock Style="{StaticResource ChipText}" Text="{Binding ScopeText}"/>
                                        </Border>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>

                        <Button Grid.Row="3" x:Name="insert_btn" Content="Insert field"
                                Style="{StaticResource SecondaryButton}" Margin="0,8,0,0"
                                HorizontalAlignment="Stretch" Click="insert_field_click"
                                ToolTip="Insert the selected field where the cursor is"/>

                        <TextBlock Grid.Row="4" Style="{StaticResource Hint}"
                                   Text="Double-click a field, or select it and press Insert field. Each field goes in as one item, written as {Label}."/>
                    </Grid>
                </Border>

                <Border Grid.Row="1" Style="{StaticResource Card}" Margin="0">
                    <StackPanel>
                        <TextBlock Style="{StaticResource CardTitle}" Text="Example"/>
                        <!-- code replaces this text with an example built from the table's own fields -->
                        <TextBlock x:Name="example_text" FontFamily="Consolas" FontSize="11"
                                   Foreground="{StaticResource Ink}" TextWrapping="Wrap"
                                   Text="IF({Height (m)} &gt; 3 m, {Area (m²)} * 2, IF({Height (m)} &gt; 2 m, {Area (m²)}, 0 m²))"/>
                        <TextBlock Style="{StaticResource Hint}"
                                   Text="Built from this table's fields, with the units they need. Elements that cannot be calculated show #ERROR."/>
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>

        <!-- ================= footer ================= -->
        <DockPanel Grid.Row="2" Margin="0,12,0,0" LastChildFill="False">
            <TextBlock x:Name="footer_hint" DockPanel.Dock="Left" Style="{StaticResource Hint}"
                       VerticalAlignment="Center" Margin="0"
                       Text="Checks run when you save. Element errors save with a warning."/>
            <Button x:Name="save_btn" DockPanel.Dock="Right" Content="Save field"
                    Style="{StaticResource PrimaryButton}" Click="save_click"/>
            <Button x:Name="cancel_btn" DockPanel.Dock="Right" Content="Cancel" Margin="0,0,8,0"
                    Style="{StaticResource SecondaryButton}" Click="cancel_click"/>
        </DockPanel>
    </Grid>
</Window>