<Window x:Class="WpfApp.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Window" Height="450" Width="600">
    <Canvas x:Name="canvasRoot" Background="White">

    <Border Width="50" Height="30" CornerRadius="10" Background="#c5c5c5"
                        HorizontalAlignment="Left" VerticalAlignment="Center" Canvas.Left="480" Canvas.Top="380">
                <Button x:Name="OK" Foreground="Black" Content="OK" Width="50" Height="30" FontWeight="Bold" />
            </Border>

            <Border Width="50" Height="30" CornerRadius="10" Background="#c5c5c5"
                        HorizontalAlignment="Left" VerticalAlignment="Center" Canvas.Left="540" Canvas.Top="380">
                <Button x:Name="Apply" Foreground="Black" Content="Apply" Width="50" Height="30" FontWeight="Bold" />
            </Border>

    

            



            <CheckBox x:Name="CheckBox1" Content="Notes" Canvas.Left="40" Canvas.Top="25" Width="100" Height="30" FontWeight="Bold"/>
            <CheckBox x:Name="CheckBox2" Content="Calculated" Canvas.Left="40" Canvas.Top="60" Width="100" Height="30" FontWeight="Bold"/>
            
                        <Border Width="510" Height="30" CornerRadius="10" Background="#c5c5c5"
                        HorizontalAlignment="Left" VerticalAlignment="Center" Canvas.Left="45" Canvas.Top="150">
                <TextBlock x:Name="Formula" Foreground="Black" Content="Formula" Width="510" Height="30" FontWeight="Bold" Padding="0,10,0,10"/>
            </Border>

            <Border Width="50" Height="30" CornerRadius="10" Background="#c5c5c5"
                        HorizontalAlignment="Left" VerticalAlignment="Center" Canvas.Left="540" Canvas.Top="380">
                <Button x:Name="Apply" Foreground="Black" Content="Apply" Width="50" Height="30" FontWeight="Bold" />
            </Border>
            
                
            
            <StackPanel x:Name="Grid1" Content="Grid1" HorizontalAlignment="Left" VerticalAlignment="Top" Width="400" Height="120" Canvas.Left="100" Canvas.Top="200" Orientation="Vertical">
            
                <StackPanel  Grid.Row="0" x:Name="StackPanel1" Content="StackPanel1" HorizontalAlignment="Left" Orientation="Horizontal">
                    <Border Width="70" Height="30" CornerRadius="10" Background="#c5c5c5"
                            HorizontalAlignment="Left" VerticalAlignment="Center" Canvas.Left="100" Canvas.Top="380">
                        <Button Foreground="Black" Content="✚" Height="30" FontWeight="Bold" />
                    </Border>
                    <Border Width="70" Height="30" CornerRadius="10" Background="#c5c5c5"
                            HorizontalAlignment="Left" VerticalAlignment="Center" Canvas.Left="100" Canvas.Top="380">
                        <Button Foreground="Black" Content="✚" Height="30" FontWeight="Bold" />
                    </Border>
                    <Border Width="70" Height="30" CornerRadius="10" Background="#c5c5c5"
                            HorizontalAlignment="Left" VerticalAlignment="Center" Canvas.Left="100" Canvas.Top="380">
                        <Button Foreground="Black" Content="✚" Height="30" FontWeight="Bold" />
                    </Border>
                </StackPanel>
            
                <StackPanel  Grid.Row="1" x:Name="StackPanel1" Content="StackPanel1" HorizontalAlignment="Left" Orientation="Horizontal">
                    <Border Width="70" Height="30" CornerRadius="10" Background="#c5c5c5"
                            HorizontalAlignment="Left" VerticalAlignment="Center" Canvas.Left="100" Canvas.Top="380">
                        <Button Foreground="Black" Content="✚" Height="30" FontWeight="Bold" />
                    </Border>
                    <Border Width="70" Height="30" CornerRadius="10" Background="#c5c5c5"
                            HorizontalAlignment="Left" VerticalAlignment="Center" Canvas.Left="100" Canvas.Top="380">
                        <Button Foreground="Black" Content="✚" Height="30" FontWeight="Bold" />
                    </Border>
                    <Border Width="70" Height="30" CornerRadius="10" Background="#c5c5c5"
                            HorizontalAlignment="Left" VerticalAlignment="Center" Canvas.Left="100" Canvas.Top="380">
                        <Button Foreground="Black" Content="✚" Height="30" FontWeight="Bold" />
                    </Border>
                </StackPanel>
            
                <StackPanel  Grid.Row="2" x:Name="StackPanel1" Content="StackPanel1" HorizontalAlignment="Left" Orientation="Horizontal">
                    <Border Width="70" Height="30" CornerRadius="10" Background="#c5c5c5"
                            HorizontalAlignment="Left" VerticalAlignment="Center" Canvas.Left="100" Canvas.Top="380">
                        <Button Foreground="Black" Content="✚" Height="30" FontWeight="Bold" />
                    </Border>
                    <Border Width="70" Height="30" CornerRadius="10" Background="#c5c5c5"
                            HorizontalAlignment="Left" VerticalAlignment="Center" Canvas.Left="100" Canvas.Top="380">
                        <Button Foreground="Black" Content="✚" Height="30" FontWeight="Bold" />
                    </Border>
                    <Border Width="70" Height="30" CornerRadius="10" Background="#c5c5c5"
                            HorizontalAlignment="Left" VerticalAlignment="Center" Canvas.Left="100" Canvas.Top="380">
                        <Button Foreground="Black" Content="✚" Height="30" FontWeight="Bold" />
                    </Border>
                </StackPanel>

            </StackPanel>
            </Canvas>
</Window>
