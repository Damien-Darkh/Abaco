<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Abaco Tables" Width="1240" Height="900" MinWidth="1100" MinHeight="760"
        WindowStartupLocation="CenterScreen" Background="#F4F5F7"
        FontFamily="Segoe UI" FontSize="12" UseLayoutRounding="True" SnapsToDevicePixels="True"
        ShowInTaskbar="False" Foreground="#1C1F24"
        Closing="window_closing">

    <!--
    CODE CONTRACT (script.py). Keep this in step with the handlers.

    Lists and selection
      fields_list       SelectionChanged = table_selection_changed. Icon column: btn_field_up,
                        btn_field_down, btn_field_remove (click handlers field_up_click, field_down_click,
                        field_remove_click). Enabled state set by update_field_buttons().
      suggest_list      SelectionChanged = suggest_selection_changed. Icon column: btn_param_add,
                        btn_param_custom, btn_param_edit, btn_param_delete. Edit and Delete are enabled
                        only for custom fields.
      level_list        ItemsControl. Row remove button has Tag="remove". Handled by one AddHandler
                        (level_row_click) on the list.
      filter_list       ItemsControl. Row remove button has Tag="remove". Handled by FilterTab.
      elem_list         ItemsControl. Buttons with Tag text | bg | bgnone. Handled by elem_row_click.
      format_list       SelectionChanged = format_selection_changed. Selection only.

    Output and store
      tb_name, tb_path, tb_prefix, tb_page_h, cmb_titleblock, tb_title are saved per category and table type.
      btn_save          save_click. Disabled when the store is blocked (newer file). store_note explains why.
      txt_unsaved       shown when the window differs from the last saved entry.
      window_closing    Closing event. Prompts when txt_unsaved is visible.
      store_note        shown when the store was blocked or a file was moved aside.
      missing_note      shown when the saved settings contain fields not in this project.

    Row numbers
      chk_rownum, tb_rownum_heading  rownum_changed. Stored as settings["rowNumbers"].

    Preview messages
      preview_status    one line, set by refresh_preview.
      revit_size_note   "TOO BIG" chip, set by size_warning. Collapsed when the table fits.
      revit_hidden_note, revit_calc_note, revit_scale_note  set in code. revit_scale_note uses PX_PER_MM.

    Events fire while the XAML loads. Every handler guards with its ready flag.
    -->

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="B2V"/>

        <!-- brushes -->
        <SolidColorBrush x:Key="Accent" Color="#2F6FDE"/>
        <SolidColorBrush x:Key="AccentHover" Color="#2459B8"/>
        <SolidColorBrush x:Key="AccentSoft" Color="#EAF1FD"/>
        <SolidColorBrush x:Key="Line" Color="#D5D9E0"/>
        <SolidColorBrush x:Key="LineSoft" Color="#E6E8EC"/>
        <SolidColorBrush x:Key="Muted" Color="#5B6472"/>
        <SolidColorBrush x:Key="Ink" Color="#1C1F24"/>
        <SolidColorBrush x:Key="WarnBg" Color="#FDEBD9"/>
        <SolidColorBrush x:Key="WarnText" Color="#8A4B08"/>
        <SolidColorBrush x:Key="GoodBg" Color="#E3F3EA"/>
        <SolidColorBrush x:Key="GoodText" Color="#14653D"/>
        <SolidColorBrush x:Key="ErrText" Color="#9B1C1C"/>

        <!-- text and surfaces -->
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="{StaticResource Line}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Padding" Value="14,10,14,12"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
        </Style>
        <Style x:Key="CardTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
            <Setter Property="Foreground" Value="{StaticResource Ink}"/>
        </Style>
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Foreground" Value="{StaticResource Muted}"/>
        </Style>
        <Style x:Key="Hint" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource Muted}"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
        <Style x:Key="WarnHint" TargetType="TextBlock" BasedOn="{StaticResource Hint}">
            <Setter Property="Foreground" Value="{StaticResource WarnText}"/>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Height" Value="26"/>
            <Setter Property="Padding" Value="4,0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="BorderBrush" Value="{StaticResource Line}"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="{StaticResource Ink}"/>
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="Height" Value="26"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="#1C1F24"/>
            <Setter Property="BorderBrush" Value="#D5D9E0"/>
            <Setter Property="Padding" Value="6,0,22,0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Auto"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton x:Name="PART_Toggle" Focusable="False" ClickMode="Press"
                                        IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border Background="{Binding Background, RelativeSource={RelativeSource AncestorType=ComboBox}}"
                                                BorderBrush="{Binding BorderBrush, RelativeSource={RelativeSource AncestorType=ComboBox}}"
                                                BorderThickness="1" CornerRadius="3">
                                            <Path HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,7,0"
                                                Data="M 0 0 L 4 4 L 8 0 Z"
                                                Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ComboBox}}"/>
                                        </Border>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>

                            <ContentPresenter x:Name="ContentSite" IsHitTestVisible="False"
                                            Content="{TemplateBinding SelectionBoxItem}"
                                            ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                            Margin="{TemplateBinding Padding}"
                                            VerticalAlignment="Center" HorizontalAlignment="Left"
                                            TextElement.Foreground="{TemplateBinding Foreground}"/>

                            <TextBox x:Name="PART_EditableTextBox" Visibility="Hidden" IsReadOnly="{TemplateBinding IsReadOnly}"
                                    Background="Transparent" BorderThickness="0" Foreground="{TemplateBinding Foreground}"
                                    Margin="{TemplateBinding Padding}" VerticalAlignment="Center" Height="Auto"/>

                            <Popup IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Bottom"
                                AllowsTransparency="True" Focusable="False" PopupAnimation="Fade">
                                <Border Background="{TemplateBinding Background}"
                                        BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1"
                                        MinWidth="{TemplateBinding ActualWidth}" MaxHeight="300">
                                    <ScrollViewer SnapsToDevicePixels="True">
                                        <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Contained"/>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsEditable" Value="True">
                                <Setter TargetName="PART_EditableTextBox" Property="Visibility" Value="Visible"/>
                                <Setter TargetName="ContentSite" Property="Visibility" Value="Hidden"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ComboBoxItem">
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="#1C1F24"/>
            <Setter Property="Padding" Value="6,3"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="ItemBd" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                            <ContentPresenter TextElement.Foreground="{TemplateBinding Foreground}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ItemBd" Property="Background" Value="#EAF1FD"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="ItemBd" Property="Background" Value="#EAF1FD"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Foreground" Value="#1C1F24"/>
        </Style>

        <!-- chips -->
        <Style x:Key="Chip" TargetType="Border">
            <Setter Property="Background" Value="#EEF0F3"/>
            <Setter Property="CornerRadius" Value="3"/>
            <Setter Property="Padding" Value="5,1"/>
            <Setter Property="Margin" Value="4,0,0,0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style x:Key="ChipWarn" TargetType="Border" BasedOn="{StaticResource Chip}">
            <Setter Property="Background" Value="{StaticResource WarnBg}"/>
        </Style>
        <Style x:Key="ChipGood" TargetType="Border" BasedOn="{StaticResource Chip}">
            <Setter Property="Background" Value="{StaticResource GoodBg}"/>
        </Style>
        <Style x:Key="ChipInfo" TargetType="Border" BasedOn="{StaticResource Chip}">
            <Setter Property="Background" Value="#E6EEFB"/>
        </Style>
        <Style x:Key="ChipText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="Foreground" Value="#3B4350"/>
        </Style>

        <!-- buttons -->
        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="{StaticResource Accent}"/>
            <Setter Property="Padding" Value="24,7"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="4"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{StaticResource AccentHover}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="bd" Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="SecondaryButton" TargetType="Button">
            <Setter Property="Foreground" Value="{StaticResource Ink}"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="Padding" Value="14,6"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="4"
                                BorderBrush="{StaticResource Line}" BorderThickness="1"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#EEF2FA"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="bd" Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="LinkButton" TargetType="Button">
            <Setter Property="Foreground" Value="{StaticResource AccentHover}"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <TextBlock x:Name="t" Text="{TemplateBinding Content}" Foreground="{TemplateBinding Foreground}"/>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="t" Property="TextDecorations" Value="Underline"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="MiniButton" TargetType="Button">
            <Setter Property="Width" Value="22"/>
            <Setter Property="Height" Value="22"/>
            <Setter Property="Margin" Value="3,0,0,0"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Foreground" Value="#3B4350"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="White" CornerRadius="3"
                                BorderBrush="{StaticResource Line}" BorderThickness="1">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#EEF2FA"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- icon button: disabled = icon at opacity 0.35 -->
        <Style x:Key="IconButton" TargetType="Button">
            <Setter Property="Width" Value="28"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="Margin" Value="0,0,0,4"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Foreground" Value="{StaticResource Ink}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="White" CornerRadius="4"
                                BorderBrush="{StaticResource Line}" BorderThickness="1">
                            <ContentPresenter x:Name="content" HorizontalAlignment="Center" VerticalAlignment="Center"
                                              TextElement.Foreground="{TemplateBinding Foreground}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#EEF2FA"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="content" Property="Opacity" Value="0.35"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- segmented radio buttons -->
        <Style x:Key="Seg" TargetType="RadioButton">
            <Setter Property="Padding" Value="10,3"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Foreground" Value="#3B4350"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="bd" Background="White" BorderBrush="{StaticResource Line}"
                                BorderThickness="1" Margin="0,0,-1,0" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{StaticResource Accent}"/>
                                <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource Accent}"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- sort direction toggle: A→Z, Z→A when checked -->
        <Style x:Key="DirToggle" TargetType="ToggleButton">
            <Setter Property="Content" Value="A→Z"/>
            <Setter Property="Foreground" Value="{StaticResource Ink}"/>
            <Setter Property="Width" Value="52"/>
            <Setter Property="Height" Value="24"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="bd" Background="White" BorderBrush="{StaticResource Line}"
                                BorderThickness="1" CornerRadius="3">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                              TextElement.Foreground="{TemplateBinding Foreground}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{StaticResource AccentSoft}"/>
                                <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource Accent}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsChecked" Value="True">
                    <Setter Property="Content" Value="Z→A"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- underlined tab strip for the inner tabs -->
        <Style x:Key="LineTabControl" TargetType="TabControl">
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabControl">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <Border Grid.Row="0" BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1">
                                <UniformGrid IsItemsHost="True" Rows="1"/>
                            </Border>
                            <ContentPresenter Grid.Row="1" ContentSource="SelectedContent"/>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="LineTab" TargetType="TabItem">
            <Setter Property="Foreground" Value="{StaticResource Muted}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="bd" BorderBrush="Transparent" BorderThickness="0,0,0,3" Padding="4,10"
                                Background="Transparent">
                            <ContentPresenter ContentSource="Header" HorizontalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#F4F7FC"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource Accent}"/>
                                <Setter Property="Foreground" Value="{StaticResource Ink}"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- selectable row in lists -->
        <Style x:Key="FmItem" TargetType="ListBoxItem">
            <Setter Property="Padding" Value="4,0"/>
            <Setter Property="Height" Value="25"/>
            <Setter Property="Foreground" Value="#1C1F24"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="bd" Background="Transparent" BorderBrush="Transparent"
                                BorderThickness="1" CornerRadius="3" Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center"
                                            TextElement.Foreground="{TemplateBinding Foreground}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#F4F7FC"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#EAF1FD"/>
                                <Setter TargetName="bd" Property="BorderBrush" Value="#2F6FDE"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- one sort level: badge, column, A→Z toggle, remove; second line: Header / Footer / Calc / Gap -->
        <DataTemplate x:Key="LevelRow">
            <Grid Margin="0,0,0,6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="24"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Border Width="16" Height="16" CornerRadius="8" Background="{StaticResource Accent}"
                        HorizontalAlignment="Left" VerticalAlignment="Center">
                    <TextBlock Text="{Binding Index}" Foreground="White" FontSize="10"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <ComboBox Grid.Column="1" Height="24" ItemsSource="{Binding Columns}"
                          SelectedItem="{Binding Column, Mode=TwoWay}" Margin="0,0,8,0"/>
                <ToggleButton Grid.Column="2" Style="{StaticResource DirToggle}"
                              IsChecked="{Binding Descending, Mode=TwoWay}"
                              ToolTip="Click to switch ascending / descending"/>
                <Button Grid.Column="3" Tag="remove" Content="×" Style="{StaticResource MiniButton}"
                        ToolTip="Remove level"/>

                <StackPanel Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="3" Orientation="Horizontal" Margin="0,4,0,0">
                    <CheckBox Content="Header" IsChecked="{Binding Header, Mode=TwoWay}" Margin="0,0,10,0"
                              ToolTip="Bold row with the group value above each block"/>
                    <CheckBox Content="Footer" IsChecked="{Binding Footer, Mode=TwoWay}" Margin="0,0,6,0"
                              ToolTip="Totals row at the end of each block"/>
                    <ComboBox Width="100" Height="22" ItemsSource="{Binding FooterModes}"
                              SelectedItem="{Binding FooterMode, Mode=TwoWay}" IsEnabled="{Binding Footer}"
                              ToolTip="What the footer calculates. Per field uses the Calculation set in the Formatting tab."
                              Margin="0,0,10,0"/>
                    <CheckBox Content="Gap row" IsChecked="{Binding Gap, Mode=TwoWay}"
                              ToolTip="Blank row after this level's blocks"/>
                </StackPanel>
            </Grid>
        </DataTemplate>

        <!-- one element of the Appearance tab -->
        <DataTemplate x:Key="ElemRow">
            <Border BorderBrush="{StaticResource LineSoft}" BorderThickness="0,0,0,1" Padding="0,4,0,6">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="110"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Text="{Binding Label}" VerticalAlignment="Center" FontWeight="SemiBold"/>
                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <CheckBox Content="Bold" IsChecked="{Binding Bold, Mode=TwoWay}" Margin="0,0,8,0"/>
                        <CheckBox Content="Italic" IsChecked="{Binding Italic, Mode=TwoWay}" Margin="0,0,8,0"/>
                        <CheckBox Content="Underline" IsChecked="{Binding Underline, Mode=TwoWay}" Margin="0,0,8,0"/>
                        <CheckBox Content="Lines" IsChecked="{Binding Lines, Mode=TwoWay}"/>
                    </StackPanel>

                    <ComboBox Grid.Row="1" Grid.Column="0" Height="22" Margin="0,4,0,0"
                            ItemsSource="{Binding CaseItems}" SelectedItem="{Binding Case, Mode=TwoWay}"/>
                    <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" Margin="0,4,0,0">
                        <Button Tag="text" Width="26" Height="20" Background="{Binding TextBrush}"
                                BorderBrush="{StaticResource Line}" ToolTip="Text colour" Margin="0,0,4,0"/>
                        <TextBlock Style="{StaticResource Hint}" Text="text" VerticalAlignment="Center" Margin="0,0,12,0"/>
                        <Button Tag="bg" Width="26" Height="20" Background="{Binding BgBrush}"
                                BorderBrush="{StaticResource Line}" ToolTip="Background colour" Margin="0,0,4,0"/>
                        <TextBlock Style="{StaticResource Hint}" Text="background" VerticalAlignment="Center" Margin="0,0,4,0"/>
                        <Button Tag="bgnone" Content="none" Style="{StaticResource LinkButton}" Margin="2,0,0,0"
                                ToolTip="Remove the background colour"/>
                    </StackPanel>

                    <StackPanel Grid.Row="2" Grid.ColumnSpan="2" Orientation="Horizontal" Margin="0,4,0,0"
                                Visibility="{Binding HasAlign, Converter={StaticResource B2V}}">
                        <TextBlock Style="{StaticResource Hint}" Text="align" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <ComboBox Width="100" Height="22" ItemsSource="{Binding AlignItems}"
                                SelectedItem="{Binding Align, Mode=TwoWay}"/>
                        <StackPanel Orientation="Horizontal" Visibility="{Binding HasOrient, Converter={StaticResource B2V}}">
                            <TextBlock Style="{StaticResource Hint}" Text="orientation" VerticalAlignment="Center" Margin="14,0,6,0"/>
                            <ComboBox Width="110" Height="22" ItemsSource="{Binding OrientItems}"
                                    SelectedItem="{Binding Orientation, Mode=TwoWay}"/>
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </Border>
        </DataTemplate>
    </Window.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- header -->
        <StackPanel Grid.Row="0" Margin="0,0,0,12">
            <TextBlock Text="Abaco Tables" FontSize="20" FontWeight="SemiBold"/>
            <TextBlock Style="{StaticResource Hint}"
                       Text="Builds the quantity table from the model, draws it as drafting views on sheets and/or writes it to Excel."/>
        </StackPanel>

        <TabControl x:Name="tabs" Grid.Row="1" Background="Transparent" BorderBrush="{StaticResource Line}">

            <!-- ============================================================ -->
            <!-- SETTINGS                                                     -->
            <!-- ============================================================ -->
            <TabItem x:Name="tab_settings" Header="Settings">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,10,6,0">
                    <StackPanel>

                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Style="{StaticResource CardTitle}" Text="1 · Source"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="170"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <TextBlock Grid.Row="0" Style="{StaticResource FieldLabel}" Text="Table type"/>
                                    <ComboBox x:Name="table_type_combo" Grid.Row="0" Grid.Column="1" SelectedIndex="0"
                                              SelectionChanged="table_type_changed">
                                        <ComboBoxItem Content="Schedule / Quantities"/>
                                        <ComboBoxItem Content="Material takeoff"/>
                                    </ComboBox>
                                    <TextBlock x:Name="table_type_note" Grid.Row="1" Grid.Column="1" Style="{StaticResource Hint}"
                                               Margin="0,3,0,8" Text="One row per type and level (and size): count, length, height, area."/>

                                    <TextBlock Grid.Row="2" Style="{StaticResource FieldLabel}" Text="Category"/>
                                    <ComboBox x:Name="category_combo" Grid.Row="2" Grid.Column="1"
                                              SelectionChanged="category_changed"/>
                                    <TextBlock x:Name="category_info" Grid.Row="3" Grid.Column="1"
                                               Style="{StaticResource Hint}" Margin="0,3,0,0"/>
                                    <TextBlock Grid.Row="4" Grid.Column="1" Style="{StaticResource Hint}" Margin="0,6,0,0"
                                               Text="To limit the table (for example curtain walls only) use the Filter tab in Preview."/>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Style="{StaticResource CardTitle}" Text="2 · Table"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="170"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <TextBlock Grid.Row="0" Style="{StaticResource FieldLabel}" Text="Title"/>
                                    <TextBox x:Name="tb_title" Grid.Row="0" Grid.Column="1"
                                             ToolTip="Title row of the table. Leave blank for 'Abaco &lt;Category&gt;'."/>
                                    <TextBlock Grid.Row="1" Style="{StaticResource FieldLabel}" Text="Table name" Margin="0,6,0,0"/>
                                    <TextBox x:Name="tb_name" Grid.Row="1" Grid.Column="1" Margin="0,6,0,0"
                                             ToolTip="Excel tab name. Also the key Abaco uses to find the Revit views on the next run, so keep it unchanged between runs."/>
                                    <TextBlock Grid.Row="2" Grid.Column="1" Style="{StaticResource Hint}" Margin="0,4,0,0"
                                               Text="Excel tab name, and the key used to find the Revit views on the next run. Keep it unchanged between runs. Columns, sorting and formatting are set in the Preview tab."/>
                                </Grid>
                            </StackPanel>
                        </Border>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Style="{StaticResource Card}">
                            <StackPanel>
                                <CheckBox x:Name="chk_revit" IsChecked="True" Margin="0,0,0,8"
                                          FontSize="13" FontWeight="SemiBold"
                                          Content="3 · Create / update drafting views in Revit"/>
                                <Grid x:Name="grid_revit" IsEnabled="{Binding IsChecked, ElementName=chk_revit}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="170"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <TextBlock Grid.Row="0" Style="{StaticResource FieldLabel}" Text="Max table height (mm)"/>
                                    <TextBox x:Name="tb_page_h" Grid.Row="0" Grid.Column="1"
                                             ToolTip="Maximum table height per view. Type blocks are never split across views."/>
                                    <TextBlock Grid.Row="1" Grid.Column="1" Style="{StaticResource Hint}" Margin="0,4,0,0"
                                               Text="Each view is one page of the table. Views are named '&lt;table name&gt; table N' and updated in place on the next run. Text size and style: Appearance tab."/>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <Border Grid.Column="2" Style="{StaticResource Card}">
                            <StackPanel>
                                <CheckBox x:Name="chk_excel" IsChecked="True" Margin="0,0,0,8"
                                          FontSize="13" FontWeight="SemiBold" Content="4 · Write to Excel"/>
                                <Grid x:Name="grid_excel" IsEnabled="{Binding IsChecked, ElementName=chk_excel}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="170"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <TextBlock Grid.Row="0" Style="{StaticResource FieldLabel}" Text="Workbook (.xlsx)"/>
                                    <TextBox x:Name="tb_path" Grid.Row="0" Grid.Column="1"/>
                                    <Button Grid.Row="0" Grid.Column="2" Content="Browse…" Margin="6,0,0,0"
                                            Style="{StaticResource SecondaryButton}" Padding="12,3"
                                            Click="browse_click"/>
                                    <TextBlock Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2"
                                               Style="{StaticResource Hint}" Margin="0,4,0,0"
                                               Text="The tab named in Table name is cleared and rewritten; other tabs are untouched. The file is created if it does not exist. Requires desktop Excel."/>
                                </Grid>
                            </StackPanel>
                        </Border>
</Grid>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ============================================================ -->
            <!-- PREVIEW: left = edit tabs, right = live table                -->
            <!-- ============================================================ -->
            <TabItem Header="Preview">
                <Grid Margin="0,10,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="420"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- left: edit tabs -->
                    <Border Grid.Column="0" Style="{StaticResource Card}" Padding="0" Margin="0">
                        <TabControl x:Name="edit_tabs" Style="{StaticResource LineTabControl}">

                            <!-- Fields -->
                            <TabItem Header="Fields" Style="{StaticResource LineTab}">
                                <Grid Margin="12,10,12,12">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                    </Grid.RowDefinitions>

                                    <DockPanel Grid.Row="0" Margin="0,0,0,6">
                                        <Button DockPanel.Dock="Right" Content="Reset" Style="{StaticResource LinkButton}"
                                                Click="fields_reset_click" VerticalAlignment="Center"
                                                ToolTip="Restore the default fields. Custom fields are kept."/>
                                        <TextBlock x:Name="fields_count" DockPanel.Dock="Right" Style="{StaticResource Hint}"
                                                   Margin="0,0,12,0" VerticalAlignment="Center"/>
                                        <TextBlock Style="{StaticResource CardTitle}" Margin="0" Text="Table fields"/>
                                    </DockPanel>

                                    <!-- shown when saved fields are not in this project -->
                                    <Border x:Name="missing_note" Grid.Row="1" Background="{StaticResource WarnBg}"
                                            CornerRadius="4" Padding="8,5" Margin="0,0,0,6" Visibility="Collapsed">
                                        <TextBlock x:Name="missing_note_text" TextWrapping="Wrap" FontSize="11"
                                                   Foreground="{StaticResource WarnText}"
                                                   Text="Some fields are not in this project and show #NOT_IN_PROJECT. Remove them with × or add the parameter again."/>
                                    </Border>

                                    <!-- table fields: selectable list, with one icon column on the right -->
                                    <Grid Grid.Row="2">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <ListBox Grid.Column="0" x:Name="fields_list"
                                                 Background="Transparent" BorderBrush="{StaticResource Line}" BorderThickness="1"
                                                 ItemContainerStyle="{StaticResource FmItem}"
                                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                                 SelectionChanged="table_selection_changed">
                                            <ListBox.ItemTemplate>
                                                <DataTemplate>
                                                    <Grid Height="24">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Text="{Binding Label}" VerticalAlignment="Center"
                                                                   TextTrimming="CharacterEllipsis"/>
                                                        <Border Grid.Column="1" Style="{StaticResource ChipInfo}"
                                                                Visibility="{Binding HasScope, Converter={StaticResource B2V}}">
                                                            <TextBlock Style="{StaticResource ChipText}" Text="{Binding ScopeText}"/>
                                                        </Border>
                                                    </Grid>
                                                </DataTemplate>
                                            </ListBox.ItemTemplate>
                                        </ListBox>

                                        <!-- icon column: act on the selected table field -->
                                        <StackPanel Grid.Column="1" Margin="6,4,0,0">

                                            <Button x:Name="btn_field_up" Style="{StaticResource IconButton}"
                                                    Click="field_up_click" ToolTip="Move up" IsEnabled="False">
                                                <Viewbox Width="16" Height="16">
                                                    <Canvas Width="16" Height="16">
                                                        <Path Fill="{StaticResource Ink}"
                                                              Data="M8.00003 7.82842L12.5858 12.4142L15.4142 9.58578L8.00003 2.17157L0.585815 9.58578L3.41424 12.4142L8.00003 7.82842Z"/>
                                                    </Canvas>
                                                </Viewbox>
                                            </Button>

                                            <Button x:Name="btn_field_down" Style="{StaticResource IconButton}"
                                                    Click="field_down_click" ToolTip="Move down" IsEnabled="False">
                                                <Viewbox Width="16" Height="16">
                                                    <Canvas Width="16" Height="16">
                                                        <Path Fill="{StaticResource Ink}"
                                                              Data="M8.00003 8.1716L3.41424 3.58582L0.585815 6.41424L8.00003 13.8285L15.4142 6.41424L12.5858 3.58582L8.00003 8.1716Z"/>
                                                    </Canvas>
                                                </Viewbox>
                                            </Button>

                                            <Button x:Name="btn_field_remove" Style="{StaticResource IconButton}"
                                                    Click="field_remove_click" ToolTip="Remove from table" IsEnabled="False">
                                                <Viewbox Width="16" Height="16">
                                                    <Canvas Width="25" Height="25">
                                                        <Path Fill="{StaticResource ErrText}"
                                                              Data="M487.148,1053.48 L492.813,1047.82 C494.376,1046.26 494.376,1043.72 492.813,1042.16 C491.248,1040.59 488.712,1040.59 487.148,1042.16 L481.484,1047.82 L475.82,1042.16 C474.257,1040.59 471.721,1040.59 470.156,1042.16 C468.593,1043.72 468.593,1046.26 470.156,1047.82 L475.82,1053.48 L470.156,1059.15 C468.593,1060.71 468.593,1063.25 470.156,1064.81 C471.721,1066.38 474.257,1066.38 475.82,1064.81 L481.484,1059.15 L487.148,1064.81 C488.712,1066.38 491.248,1066.38 492.813,1064.81 C494.376,1063.25 494.376,1060.71 492.813,1059.15 L487.148,1053.48">
                                                            <Path.RenderTransform>
                                                                <TranslateTransform X="-469" Y="-1041"/>
                                                            </Path.RenderTransform>
                                                        </Path>
                                                    </Canvas>
                                                </Viewbox>
                                            </Button>
                                        </StackPanel>
                                    </Grid>

                                    <GridSplitter Grid.Row="3" Height="2" HorizontalAlignment="Stretch" VerticalAlignment="Center"
                                                  Background="{StaticResource LineSoft}" Cursor="SizeNS" Margin="0,4,0,4" ShowsPreview="True"/>

                                    <!-- Add parameter: list (left) + icon column (right) -->
                                    <Grid Grid.Row="4">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="*"/>
                                        </Grid.RowDefinitions>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <TextBlock Grid.Row="0" Grid.ColumnSpan="2" Style="{StaticResource CardTitle}" Text="Add parameter"/>

                                        <TextBox Grid.Row="1" Grid.ColumnSpan="2" x:Name="tb_param_search"
                                                 TextChanged="param_search_changed"
                                                 ToolTip="Search the parameters found on this category"/>

                                        <ListBox x:Name="suggest_list" Grid.Row="2" Grid.Column="0" Margin="0,4,0,0"
                                                 Background="Transparent"
                                                 BorderBrush="{StaticResource Line}" BorderThickness="1"
                                                 ItemContainerStyle="{StaticResource FmItem}"
                                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                                 SelectionChanged="suggest_selection_changed">
                                            <ListBox.ItemTemplate>
                                                <DataTemplate>
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Text="{Binding Label}" VerticalAlignment="Center"
                                                                   TextTrimming="CharacterEllipsis"/>
                                                        <Border Grid.Column="1" Style="{StaticResource ChipInfo}">
                                                            <TextBlock Style="{StaticResource ChipText}" Text="{Binding ScopeText}"/>
                                                        </Border>
                                                    </Grid>
                                                </DataTemplate>
                                            </ListBox.ItemTemplate>
                                        </ListBox>

                                        <StackPanel Grid.Row="2" Grid.Column="1" Margin="6,4,0,0">

                                            <!-- ADD -->
                                            <Button x:Name="btn_param_add" Style="{StaticResource IconButton}" Click="suggest_add_click"
                                                    ToolTip="Add the selected parameter to the table" IsEnabled="False">
                                                <Canvas Width="16" Height="16">
                                                    <Path Data="M 3,1 L 10,1 L 13,4 L 13,15 L 3,15 Z" Fill="#E8EDEE"/>
                                                    <Path Data="M 10,1 L 10,4 L 13,4 Z" Fill="#B0BEC5"/>
                                                    <Rectangle Canvas.Left="5" Canvas.Top="4"  Width="3" Height="1" Fill="#78909C"/>
                                                    <Rectangle Canvas.Left="5" Canvas.Top="6"  Width="6" Height="1" Fill="#78909C"/>
                                                    <Rectangle Canvas.Left="5" Canvas.Top="8"  Width="6" Height="1" Fill="#78909C"/>
                                                    <Rectangle Canvas.Left="5" Canvas.Top="10" Width="4" Height="1" Fill="#78909C"/>
                                                    <Ellipse Canvas.Left="8.5" Canvas.Top="8.5" Width="7" Height="7" Fill="#4CAF50"/>
                                                    <Path Data="M 12,10.5 L 12,13.5 M 10.5,12 L 13.5,12" Stroke="#FFFFFF" StrokeThickness="1.2"
                                                          StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                                                </Canvas>
                                            </Button>

                                            <!-- CUSTOM FIELD -->
                                            <Button x:Name="btn_param_custom" Style="{StaticResource IconButton}" Click="suggest_custom_click"
                                                    ToolTip="New custom field (calculated)">
                                                <Viewbox Width="16" Height="16">
                                                    <Canvas Width="32" Height="32">
                                                        <Canvas.RenderTransform>
                                                            <TranslateTransform X="-16" Y="-16"/>
                                                        </Canvas.RenderTransform>
                                                        <Path Data="M 18,16 L 46,16 L 46,23 L 29,23 L 38,32 L 29,41 L 46,41 L 46,48 L 18,48 L 18,43 L 31,32 L 18,21 Z"
                                                              Fill="#FFC107"/>
                                                        <Path Data="M 18,16 L 46,16 L 46,20 L 25,20 L 18,16 Z" Fill="#FFD54F"/>
                                                    </Canvas>
                                                </Viewbox>
                                            </Button>

                                            <!-- EDIT -->
                                            <Button x:Name="btn_param_edit" Style="{StaticResource IconButton}" Click="suggest_edit_click"
                                                    ToolTip="Edit the selected custom field" IsEnabled="False">
                                                <Viewbox Width="16" Height="16">
                                                    <Canvas Width="94" Height="94">
                                                        <Canvas.Resources>
                                                            <LinearGradientBrush x:Key="pencilBody" StartPoint="0,1" EndPoint="1,0">
                                                                <GradientStop Offset="0"   Color="#E59B00"/>
                                                                <GradientStop Offset="0.5" Color="#FFC107"/>
                                                                <GradientStop Offset="1"   Color="#FFE082"/>
                                                            </LinearGradientBrush>
                                                            <LinearGradientBrush x:Key="pencilFerrule" StartPoint="0,1" EndPoint="1,0">
                                                                <GradientStop Offset="0"   Color="#B0BEC5"/>
                                                                <GradientStop Offset="0.5" Color="#CFD8DC"/>
                                                                <GradientStop Offset="1"   Color="#ECEFF1"/>
                                                            </LinearGradientBrush>
                                                            <LinearGradientBrush x:Key="pencilEraser" StartPoint="0,1" EndPoint="1,0">
                                                                <GradientStop Offset="0"   Color="#C2185B"/>
                                                                <GradientStop Offset="0.6" Color="#E91E63"/>
                                                                <GradientStop Offset="1"   Color="#F48FB1"/>
                                                            </LinearGradientBrush>
                                                            <LinearGradientBrush x:Key="pencilWood" StartPoint="0,1" EndPoint="1,0">
                                                                <GradientStop Offset="0" Color="#BDBDBD"/>
                                                                <GradientStop Offset="1" Color="#EEEEEE"/>
                                                            </LinearGradientBrush>
                                                        </Canvas.Resources>
                                                        <Canvas Width="94" Height="94">
                                                            <Canvas.RenderTransform>
                                                                <RotateTransform Angle="-45" CenterX="47" CenterY="47"/>
                                                            </Canvas.RenderTransform>
                                                            <Path Data="M 42,78 L 47,88 L 52,78 Z" Fill="#616161"/>
                                                            <Path Data="M 37,66 L 42,78 L 52,78 L 57,66 Z" Fill="{StaticResource pencilWood}"/>
                                                            <Rectangle Canvas.Left="37" Canvas.Top="28" Width="20" Height="38" RadiusX="1" RadiusY="1"
                                                                       Fill="{StaticResource pencilBody}"/>
                                                            <Rectangle Canvas.Left="37" Canvas.Top="16" Width="20" Height="12" RadiusX="1" RadiusY="1"
                                                                       Fill="{StaticResource pencilFerrule}"/>
                                                            <Path Data="M 37,16 C 37,8 57,8 57,16 Z" Fill="{StaticResource pencilEraser}"/>
                                                        </Canvas>
                                                    </Canvas>
                                                </Viewbox>
                                            </Button>

                                            <!-- DELETE: enabled for custom fields only -->
                                            <Button x:Name="btn_param_delete" Style="{StaticResource IconButton}" Click="suggest_delete_click"
                                                    ToolTip="Delete the selected custom field" IsEnabled="False">
                                                <Viewbox Width="16" Height="16">
                                                    <Canvas Width="26" Height="32">
                                                        <Path Fill="{StaticResource ErrText}"
                                                              Data="M268,220 C268,219.448 268.448,219 269,219 C269.552,219 270,219.448 270,220 L270,232 C270,232.553 269.552,233 269,233 C268.448,233 268,232.553 268,232 L268,220 L268,220 Z M273,220 C273,219.448 273.448,219 274,219 C274.552,219 275,219.448 275,220 L275,232 C275,232.553 274.552,233 274,233 C273.448,233 273,232.553 273,232 L273,220 L273,220 Z M278,220 C278,219.448 278.448,219 279,219 C279.552,219 280,219.448 280,220 L280,232 C280,232.553 279.552,233 279,233 C278.448,233 278,232.553 278,232 L278,220 L278,220 Z M263,233 C263,235.209 264.791,237 267,237 L281,237 C283.209,237 285,235.209 285,233 L285,217 L263,217 L263,233 L263,233 Z M277,209 L271,209 L271,208 C271,207.447 271.448,207 272,207 L276,207 C276.552,207 277,207.447 277,208 L277,209 L277,209 Z M285,209 L279,209 L279,207 C279,205.896 278.104,205 277,205 L271,205 C269.896,205 269,205.896 269,207 L269,209 L263,209 C261.896,209 261,209.896 261,211 L261,213 C261,214.104 261.895,214.999 262.999,215 L285.002,215 C286.105,214.999 287,214.104 287,213 L287,211 C287,209.896 286.104,209 285,209 L285,209 Z">
                                                            <Path.RenderTransform>
                                                                <TranslateTransform X="-261" Y="-205"/>
                                                            </Path.RenderTransform>
                                                        </Path>
                                                    </Canvas>
                                                </Viewbox>
                                            </Button>
                                        </StackPanel>
                                    </Grid>
                                </Grid>
                            </TabItem>

                            <!-- Filter -->
                            <TabItem Header="Filter" Style="{StaticResource LineTab}">
                                <ScrollViewer VerticalScrollBarVisibility="Auto">
                                    <StackPanel Margin="12,10,12,12">
                                        <DockPanel Margin="0,0,0,6">
                                            <Button DockPanel.Dock="Right" Content="Clear" Style="{StaticResource LinkButton}"
                                                    Click="filter_clear_click" VerticalAlignment="Center"/>
                                            <TextBlock Style="{StaticResource CardTitle}" Margin="0" Text="Filter by"/>
                                        </DockPanel>

                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                            <TextBlock Style="{StaticResource FieldLabel}" Text="Match" Margin="0,0,8,0"/>
                                            <RadioButton x:Name="filter_all" GroupName="fmatch" Style="{StaticResource Seg}"
                                                         Content="All (AND)" IsChecked="True" Click="filter_match_click"/>
                                            <RadioButton x:Name="filter_any" GroupName="fmatch" Style="{StaticResource Seg}"
                                                         Content="Any (OR)" Click="filter_match_click"/>
                                        </StackPanel>

                                        <ItemsControl x:Name="filter_list">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border BorderBrush="{StaticResource LineSoft}" BorderThickness="0,0,0,1" Padding="0,6,0,8">
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="24"/>
                                                                <ColumnDefinition Width="*"/>
                                                                <ColumnDefinition Width="Auto"/>
                                                            </Grid.ColumnDefinitions>
                                                            <Grid.RowDefinitions>
                                                                <RowDefinition Height="28"/>
                                                                <RowDefinition Height="28"/>
                                                                <RowDefinition Height="Auto"/>
                                                            </Grid.RowDefinitions>
                                                            <Border Width="16" Height="16" CornerRadius="8" Background="{StaticResource Accent}"
                                                                    HorizontalAlignment="Left" VerticalAlignment="Center">
                                                                <TextBlock Text="{Binding Index}" Foreground="White" FontSize="10"
                                                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                            </Border>
                                                            <ComboBox Grid.Column="1" Height="24" ItemsSource="{Binding Columns}"
                                                                      SelectedItem="{Binding Column, Mode=TwoWay}"/>
                                                            <Button Grid.Column="2" Tag="remove" Content="×" Style="{StaticResource MiniButton}"
                                                                    ToolTip="Remove condition"/>
                                                            <ComboBox Grid.Row="1" Grid.Column="1" Height="24" Margin="0,4,0,0"
                                                                      ItemsSource="{Binding Operators}"
                                                                      SelectedItem="{Binding Operator, Mode=TwoWay}"/>
                                                            <ComboBox Grid.Row="1" Grid.Column="2" Width="110" Height="24" Margin="6,4,0,0"
                                                                      IsEditable="True" ItemsSource="{Binding Suggestions}"
                                                                      Text="{Binding Value, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                                      Visibility="{Binding IsExact, Converter={StaticResource B2V}}"/>
                                                            <TextBox Grid.Row="1" Grid.Column="2" Width="110" Height="24" Margin="6,4,0,0"
                                                                     Text="{Binding Value, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                                     Visibility="{Binding IsText, Converter={StaticResource B2V}}"/>
                                                            <TextBlock Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="2" Style="{StaticResource WarnHint}"
                                                                       Text="{Binding Error}"
                                                                       Visibility="{Binding HasError, Converter={StaticResource B2V}}"/>
                                                        </Grid>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>

                                        <Button Content="+ Add condition" Style="{StaticResource SecondaryButton}" Padding="12,4"
                                                HorizontalAlignment="Left" Margin="0,8,0,0" Click="filter_add_click"/>

                                        <TextBlock x:Name="filter_status" Style="{StaticResource Hint}" Margin="0,10,0,0"/>
                                        <TextBlock Style="{StaticResource Hint}" Margin="0,4,0,0"
                                                   Text="Model-field conditions run on the elements before they are grouped, so counts and totals only include matching elements. Calculated-field conditions run after grouping, on the row values. Lengths and areas are compared in m and m²."/>
                                    </StackPanel>
                                </ScrollViewer>
                            </TabItem>

                            <!-- Sort &amp; group -->
                            <TabItem Header="Sort &amp; group" Style="{StaticResource LineTab}">
                                <ScrollViewer VerticalScrollBarVisibility="Auto">
                                    <StackPanel Margin="12,10,12,12">

                                        <DockPanel Margin="0,0,0,6">
                                            <Button DockPanel.Dock="Right" Content="Clear" Style="{StaticResource LinkButton}"
                                                    Click="level_clear_click" VerticalAlignment="Center"/>
                                            <TextBlock Style="{StaticResource CardTitle}" Margin="0" Text="Sort and group levels"/>
                                        </DockPanel>
                                        <TextBlock Style="{StaticResource Hint}" Margin="0,0,0,6"
                                                   Text="The first level is the outermost. Each level sorts the rows; its Header, Footer and Gap row add structure around each group of that level. Footer needs a calculation set on a field (Formatting tab)."/>
                                        <ItemsControl x:Name="level_list" ItemTemplate="{StaticResource LevelRow}"/>
                                        <Button Content="+ Add level" Style="{StaticResource SecondaryButton}" Padding="12,4"
                                                HorizontalAlignment="Left" Margin="0,6,0,0" Click="level_add_click"/>

                                        <CheckBox x:Name="chk_grand_totals" Content="Header summary (Total, Min, Max)" Margin="0,12,0,6"
                                                  Checked="options_changed" Unchecked="options_changed"/>
                                        <CheckBox x:Name="chk_itemize" Content="Itemize every instance"
                                                  Checked="options_changed" Unchecked="options_changed"/>
                                        <TextBlock Style="{StaticResource Hint}" Margin="0,6,0,0">
                                            <Run Text="Off: identical elements are merged into one row; a column whose values differ inside a row shows "/>
                                            <Run Text="Varies" FontStyle="Italic" Foreground="{StaticResource WarnText}"/>
                                            <Run Text=". On: one row per element."/>
                                        </TextBlock>

                                    </StackPanel>
                                </ScrollViewer>
                            </TabItem>

                            <!-- Formatting -->
                            <TabItem Header="Formatting" Style="{StaticResource LineTab}">
                                <DockPanel Margin="12,10,12,12">

                                    <!-- table-wide option: a numbering column, not a field -->
                                    <Border DockPanel.Dock="Bottom" Style="{StaticResource Card}" Margin="0,8,0,0">
                                        <StackPanel>
                                            <TextBlock Style="{StaticResource CardTitle}" Text="Row numbers (whole table)"/>
                                            <StackPanel Orientation="Horizontal">
                                                <CheckBox x:Name="chk_rownum" Content="Add a numbering column"
                                                        Margin="0,0,14,0" Click="rownum_changed"
                                                        ToolTip="Numbers the visible data rows 1 to N, in the final order of the table."/>
                                                <TextBlock Style="{StaticResource FieldLabel}" Text="Heading" Margin="0,0,6,0"/>
                                                <TextBox x:Name="tb_rownum_heading" Width="120" IsEnabled="{Binding IsChecked, ElementName=chk_rownum}"
                                                        TextChanged="rownum_heading_changed"
                                                        ToolTip="Heading of the numbering column"/>
                                            </StackPanel>
                                            <TextBlock Style="{StaticResource Hint}" Margin="0,6,0,0"
                                                    Text="Numbers visible data rows from 1. Header, footer, summary and blank rows get no number. Takes effect when the Excel and Revit outputs are written (not yet built, see Phase 12)."/>
                                        </StackPanel>
                                    </Border>
                                    <Grid Margin="12,10,12,12">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="190"/>
                                            <RowDefinition Height="*"/>
                                        </Grid.RowDefinitions>

                                        <DockPanel Grid.Row="0" Margin="0,0,0,6">
                                            <TextBlock DockPanel.Dock="Right" Style="{StaticResource Hint}" VerticalAlignment="Center"
                                                    Text="select one to format"/>
                                            <TextBlock Style="{StaticResource CardTitle}" Margin="0" Text="Fields"/>
                                        </DockPanel>

                                        <Border Grid.Row="1" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="3" Padding="2">
                                            <ListBox x:Name="format_list" BorderThickness="0" Background="Transparent"
                                                    ItemContainerStyle="{StaticResource FmItem}"
                                                    SelectionChanged="format_selection_changed"
                                                    ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                                <ListBox.ItemTemplate>
                                                    <DataTemplate>
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*"/>
                                                                <ColumnDefinition Width="Auto"/>
                                                                <ColumnDefinition Width="Auto"/>
                                                                <ColumnDefinition Width="Auto"/>
                                                                <ColumnDefinition Width="Auto"/>
                                                            </Grid.ColumnDefinitions>
                                                            <TextBlock Text="{Binding Label}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                                            <Border Grid.Column="1" Style="{StaticResource Chip}">
                                                                <TextBlock Style="{StaticResource ChipText}" Text="{Binding AlignChip}"/>
                                                            </Border>
                                                            <Border Grid.Column="2" Style="{StaticResource ChipWarn}"
                                                                    Visibility="{Binding HiddenInRevit, Converter={StaticResource B2V}}">
                                                                <TextBlock Style="{StaticResource ChipText}" Foreground="{StaticResource WarnText}" Text="hidden"/>
                                                            </Border>
                                                            <Border Grid.Column="3" Style="{StaticResource ChipWarn}"
                                                                    Visibility="{Binding NoExcel, Converter={StaticResource B2V}}">
                                                                <TextBlock Style="{StaticResource ChipText}" Foreground="{StaticResource WarnText}" Text="no Excel"/>
                                                            </Border>
                                                            <Border Grid.Column="4" Style="{StaticResource ChipGood}"
                                                                    Visibility="{Binding HasCalc, Converter={StaticResource B2V}}">
                                                                <TextBlock Style="{StaticResource ChipText}" Foreground="{StaticResource GoodText}" Text="Σ"/>
                                                            </Border>
                                                        </Grid>
                                                    </DataTemplate>
                                                </ListBox.ItemTemplate>
                                            </ListBox>
                                        </Border>

                                        <StackPanel x:Name="fmt_panel" Grid.Row="2" Margin="0,12,0,0" IsEnabled="False">
                                            <TextBlock x:Name="fmt_title" Style="{StaticResource CardTitle}" Text="Select a field"/>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="130"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="34"/>
                                                    <RowDefinition Height="34"/>
                                                    <RowDefinition Height="34"/>
                                                    <RowDefinition Height="34"/>
                                                </Grid.RowDefinitions>

                                                <TextBlock Grid.Row="0" Style="{StaticResource FieldLabel}" Text="Heading"/>
                                                <TextBox x:Name="fmt_heading" Grid.Row="0" Grid.Column="1" TextChanged="fmt_heading_changed"/>

                                                <TextBlock Grid.Row="1" Style="{StaticResource FieldLabel}" Text="Alignment (data)"/>
                                                <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                                    <RadioButton x:Name="align_l" GroupName="align" Style="{StaticResource Seg}"
                                                                Tag="left" Content="Left" IsChecked="True" Click="align_click"/>
                                                    <RadioButton x:Name="align_c" GroupName="align" Style="{StaticResource Seg}"
                                                                Tag="center" Content="Center" Click="align_click"/>
                                                    <RadioButton x:Name="align_r" GroupName="align" Style="{StaticResource Seg}"
                                                                Tag="right" Content="Right" Click="align_click"/>
                                                </StackPanel>

                                                <TextBlock Grid.Row="2" Style="{StaticResource FieldLabel}" Text="Column width (Revit)"/>
                                                <StackPanel Grid.Row="2" Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                                    <TextBox x:Name="fmt_width" Width="56" TextChanged="fmt_width_changed"
                                                            ToolTip="Column width on the sheet, in mm"/>
                                                    <TextBlock Style="{StaticResource Hint}" Margin="6,0,10,0" VerticalAlignment="Center" Text="mm"/>
                                                    <CheckBox x:Name="fmt_auto" Content="Auto" IsChecked="True" Click="fmt_auto_click"/>
                                                </StackPanel>

                                                <TextBlock Grid.Row="3" Style="{StaticResource FieldLabel}" Text="Calculation"/>
                                                <ComboBox x:Name="fmt_calc" Grid.Row="3" Grid.Column="1" SelectedIndex="0"
                                                        SelectionChanged="fmt_calc_changed">
                                                    <ComboBoxItem Tag="none" Content="None"/>
                                                    <ComboBoxItem Tag="total" Content="Calculate totals"/>
                                                    <ComboBoxItem Tag="min" Content="Minimum"/>
                                                    <ComboBoxItem Tag="max" Content="Maximum"/>
                                                    <ComboBoxItem Tag="minmax" Content="Minimum and maximum"/>
                                                </ComboBox>
                                            </Grid>

                                            <Separator Margin="0,6,0,6" Background="{StaticResource LineSoft}"/>
                                            <CheckBox x:Name="fmt_hidden" Content="Hidden field (Revit)" Margin="0,0,0,6" Click="fmt_flag_click"/>
                                            <CheckBox x:Name="fmt_excel" Content="Show in Excel" IsChecked="True" Click="fmt_flag_click"/>
                                            <TextBlock Style="{StaticResource Hint}" Margin="0,6,0,0"
                                                    Text="Hidden field leaves the column out of the Revit table. Show in Excel decides whether it is written to the workbook. A column hidden in Revit but off in Excel is still available for sorting."/>
                                        </StackPanel>
                                    </Grid>
                                </DockPanel>
                            </TabItem>

                            <!-- Appearance -->
                            <TabItem Header="Appearance" Style="{StaticResource LineTab}">
                                <ScrollViewer VerticalScrollBarVisibility="Auto">
                                    <StackPanel Margin="12,10,12,12">

                                        <TextBlock Style="{StaticResource CardTitle}" Text="Look"/>
                                        <Grid Margin="0,0,0,10">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="120"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>

                                            <TextBlock Grid.Row="0" Style="{StaticResource FieldLabel}" Text="Theme"/>
                                            <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal">
                                                <ComboBox x:Name="theme_combo" Width="150" SelectionChanged="theme_changed"/>
                                                <StackPanel x:Name="accent_panel" Orientation="Horizontal" Visibility="Collapsed">
                                                    <Button x:Name="sw_accent" Tag="accent" Width="26" Height="20" Margin="10,0,6,0"
                                                            BorderBrush="{StaticResource Line}" ToolTip="Accent colour (used by the Accent theme)"
                                                            Click="swatch_click"/>
                                                    <TextBlock Style="{StaticResource Hint}" VerticalAlignment="Center" Text="accent colour"/>
                                                </StackPanel>
                                            </StackPanel>

                                            <TextBlock Grid.Row="1" Style="{StaticResource FieldLabel}" Text="Font"/>
                                            <ComboBox x:Name="cmb_font" Grid.Row="1" Grid.Column="1" Width="220" HorizontalAlignment="Left"
                                                      SelectionChanged="font_changed"/>

                                            <TextBlock Grid.Row="2" Style="{StaticResource FieldLabel}" Text="Font size (mm)"/>
                                            <TextBox x:Name="tb_font_mm" Grid.Row="2" Grid.Column="1" Width="70" HorizontalAlignment="Left"
                                                     TextChanged="font_size_changed" ToolTip="Text height in mm (Revit's unit)"/>

                                            <TextBlock Grid.Row="3" Style="{StaticResource FieldLabel}" Text="Wrap text"/>
                                            <CheckBox x:Name="chk_wrap" Grid.Row="3" Grid.Column="1" Content="Wrap text in all cells"
                                                      Click="app_check_click"/>

                                            <TextBlock Grid.Row="4" Style="{StaticResource FieldLabel}" Text="Blank row (Revit, mm)"/>
                                            <TextBox x:Name="tb_blank_mm" Grid.Row="4" Grid.Column="1" Width="70" HorizontalAlignment="Left"
                                                     TextChanged="blank_changed"/>
                                        </Grid>

                                        <TextBlock Style="{StaticResource CardTitle}" Text="Elements"/>
                                        <TextBlock Style="{StaticResource Hint}" Margin="0,0,0,6"
                                                   Text="Case changes the display only. Black &amp; white: title in capitals, headings in title case, summaries in sentence case."/>
                                        <ItemsControl x:Name="elem_list" ItemTemplate="{StaticResource ElemRow}"/>

                                        <TextBlock Style="{StaticResource CardTitle}" Text="Zebra and lines" Margin="0,12,0,6"/>
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                            <CheckBox x:Name="chk_zebra" Content="Zebra striping" Margin="0,0,8,0" Click="app_check_click"/>
                                            <Button x:Name="sw_zebra" Tag="zebra" Width="26" Height="20" BorderBrush="{StaticResource Line}"
                                                    Click="swatch_click" ToolTip="Zebra colour"/>
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Style="{StaticResource FieldLabel}" Text="Lines" Margin="0,0,8,0"/>
                                            <Button x:Name="sw_lines" Tag="lines" Width="26" Height="20" BorderBrush="{StaticResource Line}"
                                                    Click="swatch_click" ToolTip="Line colour"/>
                                            <CheckBox x:Name="chk_lines_outer" Content="Outer" Margin="10,0,10,0" Click="app_check_click"/>
                                            <CheckBox x:Name="chk_lines_inner" Content="Inner" Click="app_check_click"/>
                                        </StackPanel>

                                        <TextBlock Style="{StaticResource CardTitle}" Text="Excel only" Margin="0,12,0,6"/>
                                        <CheckBox x:Name="chk_freeze" Content="Freeze the title and heading rows" Margin="0,0,0,4"
                                                  Click="app_check_click"/>
                                        <CheckBox x:Name="chk_gridlines" Content="Show gridlines" Click="app_check_click"/>

                                        <TextBlock Style="{StaticResource Hint}" Margin="0,12,0,0"
                                                   Text="Data rows take their alignment from each field in Formatting. Revit does not draw text colour; Excel and the preview do. Revit draws backgrounds, zebra striping and line colour."/>
                                    </StackPanel>
                                </ScrollViewer>
                            </TabItem>

                        </TabControl>
                    </Border>

                    <!-- right: live preview -->
                    <Grid Grid.Column="2">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <DockPanel Grid.Row="0" Margin="0,0,0,8">
                            <Button DockPanel.Dock="Right" Content="Re-read model" Style="{StaticResource SecondaryButton}"
                                    Padding="12,4" Click="reread_click"
                                    ToolTip="Read the model again. Needed only after the model has changed."/>
                            <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" Margin="0,0,12,0">
                                <RadioButton x:Name="view_excel" GroupName="view" Style="{StaticResource Seg}"
                                             Content="As Excel" IsChecked="True" Checked="view_changed"/>
                                <RadioButton x:Name="view_revit" GroupName="view" Style="{StaticResource Seg}"
                                             Content="As Revit" Checked="view_changed"/>
                            </StackPanel>
                            <TextBlock x:Name="preview_status" Style="{StaticResource Hint}" VerticalAlignment="Center"
                                       Text="Open this tab to read the model."/>
                        </DockPanel>

                        <!-- As Excel -->
                        <Border x:Name="excel_host" Grid.Row="1" Background="#FFFFFF"
                                BorderBrush="{StaticResource Line}" BorderThickness="1">
                            <DockPanel>
                                <TextBlock x:Name="preview_title" DockPanel.Dock="Top" TextAlignment="Center"
                                           TextWrapping="Wrap" Margin="8,8,8,6" Foreground="#1B1E23"/>
                                <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"
                                              Background="#FFFFFF">
                                    <Grid x:Name="excel_grid" Background="#FFFFFF" Margin="8,0,8,8"/>
                                </ScrollViewer>
                            </DockPanel>
                        </Border>

                        <!-- As Revit -->
                        <Grid x:Name="revit_host" Grid.Row="1" Visibility="Collapsed">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <WrapPanel Grid.Row="0" Margin="0,0,0,8">
                                <Border x:Name="revit_size_chip" Style="{StaticResource ChipWarn}" Margin="0,0,8,0" Visibility="Collapsed">
                                    <TextBlock x:Name="revit_size_note" Style="{StaticResource ChipText}"
                                               Foreground="{StaticResource ErrText}" FontWeight="SemiBold" Text=""/>
                                </Border>
                                <Border Style="{StaticResource ChipWarn}" Margin="0,0,8,0">
                                    <TextBlock x:Name="revit_hidden_note" Style="{StaticResource ChipText}"
                                               Foreground="{StaticResource WarnText}" Text="Hidden in Revit: none"/>
                                </Border>
                                <Border Style="{StaticResource ChipGood}" Margin="0,0,8,0">
                                    <TextBlock x:Name="revit_calc_note" Style="{StaticResource ChipText}"
                                               Foreground="{StaticResource GoodText}" Text="No calculations"/>
                                </Border>
                                <Border Style="{StaticResource Chip}" Margin="0">
                                    <TextBlock x:Name="revit_scale_note" Style="{StaticResource ChipText}" Text=""/>
                                </Border>
                            </WrapPanel>
                            <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"
                                          Background="#E3E7ED">
                                <Border Background="#FFFFFF" Padding="14" Margin="14" HorizontalAlignment="Left" VerticalAlignment="Top">
                                    <Border.Effect>
                                        <DropShadowEffect BlurRadius="6" ShadowDepth="1" Opacity="0.25"/>
                                    </Border.Effect>
                                    <StackPanel>
                                        <StackPanel x:Name="width_ruler" Orientation="Horizontal" Height="14"/>
                                        <Canvas x:Name="revit_canvas"/>
                                    </StackPanel>
                                </Border>
                            </ScrollViewer>
                        </Grid>
                    </Grid>
                </Grid>
            </TabItem>
        </TabControl>

        <!-- store status: shown when the saved-settings file was blocked or moved aside -->
        <Border x:Name="store_note" Grid.Row="2" Background="{StaticResource WarnBg}" CornerRadius="4"
                Padding="10,6" Margin="0,0,0,8" Visibility="Collapsed">
            <TextBlock x:Name="store_note_text" TextWrapping="Wrap" Foreground="{StaticResource WarnText}" Text=""/>
        </Border>

        <!-- log -->
        <Border Grid.Row="3" Style="{StaticResource Card}" Margin="0,0,0,10" Padding="8">
            <TextBox x:Name="log_box" Height="96" IsReadOnly="True" BorderThickness="0"
                     FontFamily="Consolas" FontSize="11" TextWrapping="Wrap" AcceptsReturn="True"
                     VerticalScrollBarVisibility="Auto" VerticalContentAlignment="Top"/>
        </Border>

        <!-- footer: status on the left; Save settings, Run and Close on the right -->
        <DockPanel Grid.Row="4" LastChildFill="False">
            <TextBlock x:Name="status_text" DockPanel.Dock="Left" Style="{StaticResource Hint}"
                       VerticalAlignment="Center" Text="Ready"/>
            <Button x:Name="btn_close" DockPanel.Dock="Right" Content="Close" Margin="8,0,0,0"
                    Style="{StaticResource SecondaryButton}" Padding="16,7" Click="close_click"/>
            <Button x:Name="btn_run" DockPanel.Dock="Right" Content="Run" Margin="8,0,0,0"
                    Style="{StaticResource PrimaryButton}" Click="run_click"/>
            <TextBlock x:Name="txt_unsaved" DockPanel.Dock="Right" Margin="0,0,12,0" VerticalAlignment="Center"
                       Foreground="{StaticResource WarnText}" FontSize="11" FontWeight="SemiBold"
                       Text="Unsaved changes" Visibility="Collapsed"/>
            <Button x:Name="btn_save" DockPanel.Dock="Right" Content="Save settings"
                    Style="{StaticResource SecondaryButton}" Padding="16,7" Click="save_click"
                    ToolTip="Save the settings of this category and table type to tables.json"/>
        </DockPanel>
    </Grid>
</Window>